{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "trailingSlash": true,
    "redirects": [
      {
        "source": "/portfolio/goldluckwine{,/}",
        "destination": "/portfolio/wine-importer/",
        "type": 301
      },
      {
        "source": "/brief{,/}",
        "destination": "/guides/project-brief/",
        "type": 301
      }
    ]
  }
}
